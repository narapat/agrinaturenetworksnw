# Firebase Configuration for Agri-Nature Network Nakhon Sawan
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agrinature-network-nsw.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agrinature-network-nsw
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agrinature-network-nsw.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# LINE LIFF Configuration
NEXT_PUBLIC_LIFF_ID=your_liff_id_here

# Admin Security Configuration (Server-Side ONLY - NEVER prefix with NEXT_PUBLIC_)
ADMIN_PASSCODE=your_secure_admin_passcode
ADMIN_SESSION_SECRET=your_random_hmac_secret_string
ADMIN_LINE_USER_IDS=U0123456789abcdef0123456789abcdef,Uotherlineuserid
