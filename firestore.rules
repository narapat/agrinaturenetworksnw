rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & AUTH VERIFICATION
    // ==========================================

    // ตรวจสอบว่าผู้ใช้ผ่านการยืนยันตัวตน (Firebase Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // ตรวจสอบสิทธิ์ผู้ดูแลระบบ (Admin Claim หรือ Email เฉพาะ)
    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('email' in request.auth.token && request.auth.token.email == 'agrinature.network.nsw@gmail.com')
      );
    }

    // ตรวจสอบความเป็นเจ้าของเอกสารด้วย UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ตรวจสอบความถูกต้องของสตริงทั่วไป
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // ตรวจสอบความถูกต้องของตัวเลข
    function isValidNumber(num, minVal, maxVal) {
      return (num is int || num is float) && num >= minVal && num <= maxVal;
    }

    // ==========================================
    // 1. MEMBERS COLLECTION & SUBCOLLECTIONS
    // ==========================================
    match /members/{memberId} {
      // สมาชิกที่ยืนยันตัวตนแล้ว หรือ แอดมิน เท่านั้นที่อ่านรายชื่อสมาชิกได้
      allow read: if isAuthenticated();

      // การสมัครสมาชิกใหม่ (Self-registration):
      // บังคับสถานะเริ่มต้นต้องเป็น 'pending' เสมอ (ห้ามตั้งเป็น 'approved' หรือ 'admin' เอง)
      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && (request.resource.data.role == 'member' || request.resource.data.role == 'guest')
                    && request.resource.data.status == 'pending';

      // การแก้ไขข้อมูลสมาชิก:
      // เจ้าของบัญชี (ตรงตาม ownerUid หรือ memberId) แก้ไขได้ แต่ห้ามเปลี่ยนสถานะ (status) ของตนเองเด็ดขาด
      // การอนุมัติ (status == 'approved') ทำได้โดยแอดมินเท่านั้น
      allow update: if (
                      isAuthenticated() &&
                      (resource.data.ownerUid == request.auth.uid || isOwner(memberId)) &&
                      request.resource.data.status == resource.data.status
                    ) || isAdmin();

      // ไม่อนุญาตให้ลบข้อมูลสมาชิกโดยตรง สงวนให้แอดมินเท่านั้น
      allow delete: if isAdmin();

      // Subcollection ข้อมูลส่วนบุคคลอ่อนไหว (PII: เบอร์โทร, LINE ID, รูปหน้า, ประวัติการอบรม)
      match /private/pii {
        allow read: if isAuthenticated() && (
          resource.data.ownerUid == request.auth.uid ||
          isOwner(memberId) ||
          isAdmin()
        );
        allow write: if isAuthenticated() && (
          (resource != null && (resource.data.ownerUid == request.auth.uid || isOwner(memberId))) ||
          (resource == null && (request.resource.data.ownerUid == request.auth.uid || isOwner(memberId))) ||
          isAdmin()
        );
      }
    }

    // ==========================================
    // 2. FARMS COLLECTION & SUBCOLLECTIONS
    // ==========================================
    match /farms/{farmId} {
      // แปลงที่ได้รับการอนุมัติ (approved) เปิดให้อ่านสาธารณะ
      // แปลงที่รอดำเนินการอ่านได้เฉพาะเจ้าของหรือแอดมิน
      allow read: if (resource.data.status == 'approved') ||
                     (isAuthenticated() && (
                       resource.data.ownerUid == request.auth.uid ||
                       resource.data.memberId == request.auth.uid ||
                       isAdmin()
                     ));

      // สร้างแปลงใหม่พร้อมข้อมูลที่ถูกต้อง บังคับสถานะเริ่มต้นต้องเป็น 'pending' (ห้ามตั้ง approved เอง)
      allow create: if isValidString(request.resource.data.farmName, 2, 150)
                    && isValidString(request.resource.data.ownerName, 2, 120)
                    && request.resource.data.district is string
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() <= 10
                    && (!('status' in request.resource.data) || request.resource.data.status == 'pending');

      // อัปเดตข้อมูลแปลง: เจ้าของแปลง (ตรงตาม ownerUid หรือ memberId) หรือ แอดมิน
      // เจ้าของแปลงแก้ไขได้ แต่ห้ามเปลี่ยนสถานะ (status) ของตนเองเด็ดขาด
      // การอนุมัติ (status == 'approved') ทำได้โดยแอดมินเท่านั้น
      allow update: if (
        isAuthenticated() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.memberId == request.auth.uid) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      ) || isAdmin();

      // ไม่อนุญาตให้ลบแปลงโดยตรง สงวนให้แอดมิน
      allow delete: if isAdmin();

      // Subcollection สำหรับพิกัด GPS จริง (internalCoordinates) และเบอร์ติดต่อส่วนบุคคล
      // เก็บ ownerUid ใน subdocument เองเพื่อไม่ต้อง get() parent document
      match /private/contact {
        allow read: if isAuthenticated() && (
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );
        allow write: if isAuthenticated() && (
          (resource != null && resource.data.ownerUid == request.auth.uid) ||
          (resource == null && request.resource.data.ownerUid == request.auth.uid) ||
          isAdmin()
        );
      }
    }

    // ==========================================
    // 3. PRODUCTS COLLECTION (ผลผลิต & ปัจจัยการผลิต)
    // ==========================================
    match /products/{productId} {
      // อ่านข้อมูลผลผลิตสาธารณะได้
      allow read: if true;

      // สมาชิกที่ล็อกอินหรือแอดมิน เพิ่มและแก้ไขผลผลิต
      allow create: if isAuthenticated()
                    && isValidString(request.resource.data.title, 2, 150)
                    && isValidNumber(request.resource.data.price, 0, 1000000)
                    && request.resource.data.status in ['sale', 'share', 'preorder', 'out_of_stock', 'hidden']
                    && request.resource.data.images is list
                    && request.resource.data.images.size() <= 6;

      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() || isAdmin();
    }

    // ==========================================
    // 4. CATEGORIES, PRACTICES, NEWS
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /practices/{practiceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. AUDIT LOGS (Zero Client Writes)
    // ==========================================
    match /auditLogs/{logId} {
      // ประวัติความโปร่งใสอ่านได้เฉพาะแอดมิน
      allow read: if isAdmin();
      // ปฏิเสธการเขียนตรงจากเบราว์เซอร์ 100% (เขียนผ่าน Firebase Admin SDK บน Server API เท่านั้น)
      allow write: if false;
    }

    // ==========================================
    // 6. DEFAULT DENY-ALL RULE
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
