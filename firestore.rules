rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & VALIDATIONS
    // ==========================================

    // ตรวจสอบว่าผู้ใช้มีบทบาทผู้ดูแลระบบ (Admin)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'agrinature.network.nsw@gmail.com'
      );
    }

    // ตรวจสอบความถูกต้องของสตริงทั่วไป (ป้องกัน DoS / Storage Abuse)
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // ตรวจสอบความถูกต้องของตัวเลข
    function isValidNumber(num, minVal, maxVal) {
      return (num is int || num is float) && num >= minVal && num <= maxVal;
    }

    // ==========================================
    // 1. MEMBERS COLLECTION (ข้อมูลสมาชิก)
    // ==========================================
    match /members/{memberId} {
      // บุคคลทั่วไปสามารถอ่านรายชื่อสมาชิกเพื่อดูผู้ผลิตได้
      allow read: if true;

      // การสมัครสมาชิกใหม่ (Self-registration)
      // กำหนดให้สถานะเริ่มต้นต้องเป็น 'pending' เสมอ ห้ามแต่งตั้งตนเองเป็น 'admin'
      allow create: if isValidString(request.resource.data.fullName, 2, 120)
                    && (request.resource.data.role == 'member' || request.resource.data.role == 'guest')
                    && request.resource.data.status in ['pending', 'approved']
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30;

      // การแก้ไขข้อมูลสมาชิก: เจ้าของบัญชีหรือแอดมินเท่านั้น
      allow update: if (
                      // หากเป็นผู้ใช้แก้ไขข้อมูลแปลง/โปรไฟล์ตนเอง ห้ามเปลี่ยน status หรือสิทธิ์ admin เอง
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'fullName', 'facePhotoUrl', 'lineId', 'phone', 'isPublicPhone',
                        'isPublicLine', 'isPublicSocials', 'socials', 'fontSizePref',
                        'farmId', 'delegationStatus', 'delegationNote', 'lineUserId'
                      ])
                    ) || isAdmin();

      // ลบสมาชิกได้เฉพาะแอดมินเท่านั้น
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. FARMS COLLECTION (ข้อมูลแปลงกสิกรรม)
    // ==========================================
    match /farms/{farmId} {
      // ข้อมูลแปลงและเรื่องเล่าปรัชญาอ่านได้สาธารณะ
      allow read: if true;

      // สร้างแปลงใหม่พร้อมข้อมูลที่ถูกต้อง
      allow create: if isValidString(request.resource.data.farmName, 2, 150)
                    && isValidString(request.resource.data.ownerName, 2, 120)
                    && request.resource.data.district is string
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() <= 10;

      // อัปเดตข้อมูลแปลง
      allow update: if isValidString(request.resource.data.farmName, 2, 150)
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() <= 10;

      // ลบแปลงได้เฉพาะแอดมินเท่านั้น
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. PRODUCTS COLLECTION (ผลผลิต & ปัจจัยการผลิต)
    // ==========================================
    match /products/{productId} {
      // ผลผลิตในตลาดเครือข่ายเปิดให้อ่านสาธารณะ
      allow read: if true;

      // สมาชิกเพิ่มผลผลิตเข้าสู่ระบบ
      allow create: if isValidString(request.resource.data.title, 2, 150)
                    && isValidNumber(request.resource.data.price, 0, 1000000)
                    && request.resource.data.status in ['sale', 'share', 'preorder', 'out_of_stock', 'hidden']
                    && request.resource.data.images is list
                    && request.resource.data.images.size() <= 6;

      // อัปเดตข้อมูลผลผลิตและสต็อก
      allow update: if isValidString(request.resource.data.title, 2, 150)
                    && isValidNumber(request.resource.data.price, 0, 1000000)
                    && request.resource.data.status in ['sale', 'share', 'preorder', 'out_of_stock', 'hidden'];

      // ลบผลผลิตได้
      allow delete: if true;
    }

    // ==========================================
    // 4. CATEGORIES COLLECTION (หมวดหมู่ & SKU)
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidString(request.resource.data.name, 2, 80);
    }

    // ==========================================
    // 5. NEWS COLLECTION (ข่าวสาร & ตารางเอามื้อ)
    // ==========================================
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isValidString(request.resource.data.title, 2, 200)
                                    && isValidString(request.resource.data.content, 5, 20000);
    }

    // ==========================================
    // 6. AUDIT LOGS COLLECTION (ประวัติความโปร่งใส)
    // ==========================================
    match /auditLogs/{logId} {
      // ประวัติการคัดกรองและการช่วยเหลือของแอดมิน
      allow read: if true;
      // บันทึก Log เพิ่มเติมได้ แต่ห้ามแก้ไขหรือลบย้อนหลังโดยเด็ดขาด (Append-only)
      allow create: if isValidString(request.resource.data.action, 2, 50);
      allow update, delete: if false;
    }

  }
}
